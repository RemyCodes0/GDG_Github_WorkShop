# Copy to .env.production (never commit it) and replace every value marked CHANGE.
# docker compose reads it automatically.

DJANGO_SECRET_KEY=CHANGE-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=collab.example.edu,backend
DJANGO_CSRF_TRUSTED_ORIGINS=https://collab.example.edu
DJANGO_HTTPS=True

DB_NAME=aubcollab
DB_USER=aubcollab
DB_PASSWORD=CHANGE-to-a-strong-password

GUNICORN_WORKERS=3
WEB_PORT=8080
